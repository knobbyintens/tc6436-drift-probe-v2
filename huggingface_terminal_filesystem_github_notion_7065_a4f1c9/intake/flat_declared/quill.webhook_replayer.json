      "description": "Destination URL.",
      "type": "string"
    },
    "headers": {
      "description": "Additional request headers.",
      "type": "object",
      "default": null
    },
    "signature": {
      "description": "Request signature.",
      "type": "String, Optional"
    }
  }
}
