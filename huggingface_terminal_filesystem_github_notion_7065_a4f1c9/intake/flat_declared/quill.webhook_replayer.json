{
  "tool_id": "quill.webhook_replayer",
  "owner": "quill",
  "tool_name": "webhook_replayer",
  "display_name": "Webhook Replayer",
  "summary": "Replay a recorded webhook delivery.",
  "build_path": "builds/quill/webhook_replayer",
  "parameters": {
    "event_id": {
      "description": "Recorded event identifier.",
