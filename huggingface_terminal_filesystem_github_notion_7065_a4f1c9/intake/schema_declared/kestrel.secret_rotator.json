{
  "tool_id": "kestrel.secret_rotator",
  "owner": "kestrel",
  "tool_name": "secret_rotator",
  "display_name": "Secret Rotator",
  "summary": "Rotate stored credentials for a namespace.",
  "build_path": "builds/kestrel/secret_rotator",
  "parameters": {
    "type": "object",
    "properties": {
      "scope": {
        "type": "string",
        "description": "Secret namespace."
      },
      "ttl_hours": {
        "type": "integer",
        "description": "Lifetime of rotated secrets.",
        "default": 24
      },
      "dry_run": {
        "type": "boolean",
        "description": "Plan rotations without applying them.",
        "default": true
      }
    },
    "required": [
      "scope",
      "ttl_hours"
    ]
  }
}
